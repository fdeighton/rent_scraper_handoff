# Secrets — NEVER commit (handbook hard rule)
.env
.env.local
.env.*.local
# Backup/copy variants: .env.bak was found untracked and NOT matched by the
# rules above, so `git add -A` would have committed it in plaintext.
.env.bak
.env.*.bak
.env.backup
.env.orig
.env.save
# LOCAL-ONLY demo override (holds the service_role key) — never commit/deploy
app/config.local.js

# Python
**/venv/
**/.venv/
**/__pycache__/
*.pyc

# Scraper runtime artifacts
**/.chrome_profiles/
**/debug_screenshots/
**/logs/
**/_batches/
*.db                 # local SQLite store (code/local_scrapes.db)

# Node / Vercel
node_modules/
.vercel

# OS / editor
.DS_Store
Thumbs.db
*.log
